# Copy to .env and fill in your own values. NEVER commit the real .env file.
# The application reads these variables if present. .env is optional; the app
# also lets you enter these values in the UI at runtime.

# Google Gemini API key. Leave blank to run fully offline (local DSP only).
GEMINI_API_KEY=

# Gemini model id used for optional assistant features.
# Change this to any model available to your account.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional explicit paths to the FFmpeg tools if they are not on PATH.
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# Feature extraction / alignment defaults (optional overrides).
PIANOSYNC_SAMPLE_RATE=22050
PIANOSYNC_HOP_LENGTH=512
